<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Result</title>

  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;900&display=swap" rel="stylesheet">

  <style>

    *{
      box-sizing:border-box;
    }

    body{
      margin:0;
      min-height:100vh;
      font-family:'Orbitron', sans-serif;

      background:
      radial-gradient(circle at top right,#ead5ff 0%,transparent 28%),
      radial-gradient(circle at bottom left,#d9efff 0%,transparent 28%),
      #fffaff;

      overflow-x:hidden;
    }

    .page{
      min-height:100vh;
      padding:35px 45px 50px;
      position:relative;
    }

    /* ================= 왼쪽 위 로고 ================= */

    .top-logo{
      position:absolute;
      top:28px;
      left:40px;

      display:flex;
      align-items:center;
      gap:16px;
    }

    .logo-title{
      margin:0;
      line-height:.9;
      letter-spacing:-1px;
    }

    .logo-text{
      display:block;

      font-size:34px;
      font-weight:900;

      background:linear-gradient(
        90deg,
        #0f8fff 0%,
        #1d7cff 35%,
        #6c63ff 68%,
        #b44cf0 100%
      );

      -webkit-background-clip:text;
      background-clip:text;

      -webkit-text-fill-color:transparent;
      color:transparent;
    }

    /* ================= 원자 로고 ================= */

    .atom-logo{
      position:relative;
      width:72px;
      height:72px;
    }

    .orbit{
      position:absolute;
      top:50%;
      left:50%;

      width:64px;
      height:24px;

      border:3px solid;
      border-radius:50%;

      transform:translate(-50%,-50%);
    }

    .orbit1{
      border-color:#1695e8;
      transform:translate(-50%,-50%) rotate(0deg);
    }

    .orbit2{
      border-color:#8c39e8;
      transform:translate(-50%,-50%) rotate(60deg);
    }

    .orbit3{
      border-color:#1db2ea;
      transform:translate(-50%,-50%) rotate(-60deg);
    }

    .electron{
      position:absolute;

      width:10px;
      height:10px;

      border-radius:50%;

      background:linear-gradient(135deg,#0a8fe8,#9b31e7);

      box-shadow:0 0 10px rgba(147,51,234,.8);
    }

    .electron1{
      top:-5px;
      left:56%;
    }

    .electron2{
      bottom:-4px;
      right:18%;
    }

    /* ================= RESULT 제목 ================= */

    .result-title{
      margin-top:120px;
      margin-bottom:65px;

      text-align:center;
      line-height:.88;
    }

    .result-text{
      display:block;

      font-size:130px;
      font-weight:900;

      letter-spacing:-4px;
      line-height:.9;

      /* 기울기 제거 */
      transform:none;

      background:linear-gradient(
        90deg,
        #12a8ff 0%,
        #388fff 25%,
        #8660ff 58%,
        #c04dff 100%
      );

      -webkit-background-clip:text;
      background-clip:text;

      -webkit-text-fill-color:transparent;
      color:transparent;

      filter:drop-shadow(0 0 10px rgba(120,120,255,.18));
    }

    /* ================= 카드 영역 ================= */

    .content{
      width:1100px;
      max-width:95%;
      margin:0 auto;

      display:grid;
      grid-template-columns:1.45fr 1fr;
      gap:26px;
    }

    .left,
    .right{
      display:flex;
      flex-direction:column;
      gap:24px;
    }

    .card{
      background:rgba(255,255,255,.74);

      border:3px dashed #d39cff;
      border-radius:30px;

      box-shadow:0 0 24px rgba(147,51,234,.08);
    }

    .risk-card{
      padding:32px;
    }

    .risk-row{
      display:flex;
      align-items:center;
      gap:20px;
    }

    .risk-title{
      min-width:100px;

      font-size:30px;
      font-weight:900;

      color:#9839e9;
    }

    .risk-bar{
      flex:1;
      height:38px;

      border:3px solid #1698e7;
      border-radius:14px;

      overflow:hidden;
      background:#eef4fa;
    }

    .risk-fill{
      width:60%;
      height:100%;

      background:#ffd60a;
      transition:.25s;
    }

    .risk-percent{
      width:90px;

      text-align:right;

      font-size:30px;
      font-weight:900;

      color:#0b8fe8;
    }

    .slider-wrap{
      margin-top:22px;

      display:flex;
      align-items:center;
      gap:15px;
    }

    .num{
      font-size:16px;
      font-weight:900;

      color:#8d39e8;
    }

    input[type="range"]{
      flex:1;
      cursor:pointer;
    }

    .formula-card,
    .element-card,
    .note-card{
      padding:38px;
    }

    .formula-card{
      min-height:335px;
    }

    .element-card{
      min-height:315px;
    }

    .note-card{
      flex:1;
      min-height:210px;

      display:flex;
      justify-content:center;
      align-items:flex-start;
    }

    /* ================= 제목들 ================= */

    .formula-head{
      display:flex;
      align-items:center;
      gap:50px;

      margin-bottom:35px;
    }

    .spark-title,
    .element-title,
    .formula-name{
      position:relative;

      display:inline-block;

      font-size:36px;
      font-weight:900;

      background:linear-gradient(90deg,#8e37e8,#0b90e8);

      -webkit-background-clip:text;
      background-clip:text;

      -webkit-text-fill-color:transparent;
      color:transparent;
    }

    .formula-name{
      font-size:24px;
    }

    .underline{
      position:absolute;
      left:0;
      bottom:-8px;

      width:100%;
      height:4px;

      border-radius:999px;

      background:linear-gradient(90deg,#8e37e8,#0b90e8);
    }

    /* ================= 텍스트 ================= */

    .info-line,
    .element-info{
      margin:20px 0;

      font-size:20px;
      font-weight:900;
      line-height:1.55;

      color:#8f37e8;
    }

    .info-line span,
    .element-info span{
      color:#0a90e8;
    }

    .note-title{
      font-size:34px;
      font-weight:900;

      color:#0a90e8;
    }

    /* ================= 버튼 ================= */

    .button-wrap{
      width:1100px;
      max-width:95%;

      margin:0 auto;

      display:flex;
      justify-content:flex-end;
    }

    .home-btn{
      margin-top:35px;

      width:390px;
      height:82px;

      border:4px solid #b44cf0;
      border-radius:28px;

      background:white;

      color:#0b8fe8;

      font-size:28px;
      font-weight:900;

      font-family:'Orbitron', sans-serif;

      cursor:pointer;

      box-shadow:10px 10px 0 rgba(180,76,240,.22);

      transition:.2s;
    }

    .home-btn:hover{
      transform:translateY(-4px);
    }

  </style>
</head>

<body>

  <div class="page">

    <!-- 로고 -->
    <div class="top-logo">

      <h1 class="logo-title">
        <span class="logo-text">Chemicom</span>
      </h1>

      <div class="atom-logo">

        <div class="orbit orbit1">
          <div class="electron electron1"></div>
        </div>

        <div class="orbit orbit2">
          <div class="electron electron2"></div>
        </div>

        <div class="orbit orbit3"></div>

      </div>

    </div>

    <!-- RESULT -->
    <div class="result-title">

      <span class="result-text">
        Result
      </span>

    </div>

    <!-- 카드 -->
    <main class="content">

      <section class="left">

        <div class="card risk-card">

          <div class="risk-row">

            <div class="risk-title">
              위험도
            </div>

            <div class="risk-bar">
              <div class="risk-fill" id="riskFill"></div>
            </div>

            <div class="risk-percent" id="riskText">
              60%
            </div>

          </div>

          <div class="slider-wrap">

            <span class="num">0</span>

            <input
              type="range"
              min="0"
              max="100"
              value="60"
              id="riskRange"
            >

            <span class="num">100</span>

          </div>

        </div>

        <div class="card formula-card">

          <div class="formula-head">

            <div class="spark-title">
              화학식
              <div class="underline"></div>
            </div>

            <div class="formula-name">
              산 / 염기
            </div>

          </div>

          <p class="info-line">
            설명 : <span>화학 물질 설명</span>
          </p>

          <p class="info-line">
            활용 예시 : <span>실험, 산업, 생활</span>
          </p>

          <p class="info-line">
            주의 사항 : <span>피부 접촉 주의</span>
          </p>

          <p class="info-line">
            분자량 : <span>98.08 g/mol</span>
          </p>

        </div>

      </section>

      <section class="right">

        <div class="card element-card">

          <div class="element-title">
            원소 이름
            <div class="underline"></div>
          </div>

          <p class="element-info">
            원자 설명 : <span>산소</span>
          </p>

          <p class="element-info">
            원소 기호 : <span>O</span>
          </p>

          <p class="element-info">
            원자량 : <span>15.999</span>
          </p>

        </div>

        <div class="card note-card">

          <div class="note-title">
            참고사항
          </div>

        </div>

      </section>

    </main>

    <!-- 버튼 -->
    <div class="button-wrap">

      <button
        class="home-btn"
        onclick="location.href='index.html'"
      >
        ⌂ 홈으로 돌아가기
      </button>

    </div>

  </div>

  <script>

    const riskRange =
    document.getElementById("riskRange");

    const riskFill =
    document.getElementById("riskFill");

    const riskText =
    document.getElementById("riskText");

    function updateRisk(){

      const value =
      Number(riskRange.value);

      riskText.textContent =
      value + "%";

      riskFill.style.width =
      value + "%";

      if(value <= 30){
        riskFill.style.background =
        "#30d158";
      }

      else if(value <= 70){
        riskFill.style.background =
        "#ffd60a";
      }

      else{
        riskFill.style.background =
        "#ff3b30";
      }

    }

    riskRange.addEventListener(
      "input",
      updateRisk
    );

    updateRisk();

  </script>

</body>
</html>
